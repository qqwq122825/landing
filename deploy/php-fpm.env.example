; Add these to a dedicated PHP-FPM pool, edit values, then reload PHP-FPM.
; Existing env files are not loaded automatically by this application.
env[HUB_ORIGIN] = https://YOUR_DOMAIN
env[HUB_DATA_DIR] = /var/lib/landing-hub
env[HUB_DEV] = 0
; Optional Facebook domain verification for the root-domain login page:
; env[HUB_FACEBOOK_VERIFY] = YOUR_VERIFICATION_CODE
