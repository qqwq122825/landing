# Example only. Replace the domain, certificate paths and PHP-FPM socket.
# Deploy directory: /srv/landing-hub ; document root MUST be public/.
server {
    listen 443 ssl;
    server_name YOUR_DOMAIN;
    ssl_certificate /path/to/fullchain.pem;
    ssl_certificate_key /path/to/privkey.pem;
    root /srv/landing-hub/public;
    index index.php;
    client_max_body_size 400k;
    autoindex off;

    location / { try_files $uri /index.php$is_args$args; }
    location = /install.php { rewrite ^ /index.php last; }
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        # If real_ip already rewrites $remote_addr, use the original proxy peer:
        # fastcgi_param TV_PROXY_PEER $realip_remote_addr;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
    }
    location ~ \.php$ { return 404; }
    location ~ /\. { deny all; }
    location ^~ /themes/ { try_files $uri =404; expires 1d; }
    location ^~ /assets/ { try_files $uri =404; expires -1; }
}
server {
    listen 80;
    server_name YOUR_DOMAIN;
    return 301 https://$host$request_uri;
}
